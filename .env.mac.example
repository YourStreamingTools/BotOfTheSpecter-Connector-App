# macOS signing + notarization settings for ./build.sh --mac.
# Copy this file to .env.mac (git ignores .env.mac, so it is never committed) and fill it in.
# Keep the .p8 key file outside the repo.

# App Store Connect API key (recommended)
APPLE_API_KEY=/Users/you/.private_keys/AuthKey_XXXXXXXXXX.p8
APPLE_API_KEY_ID=XXXXXXXXXX
APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000

# Or an Apple ID instead of the API key (leave the three lines above out):
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=XXXXXXXXXX

# Only if the keychain holds more than one Developer ID Application certificate:
# CSC_NAME="Your Name (TEAMID1234)"
